# セッションCookieの署名鍵。本番では必ずランダムな長い文字列に変更してください。
# 例: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string

# SQLite ファイルの保存先（省略時は ./data/creator-dm.db）
DATABASE_PATH=./data/creator-dm.db

# 初期管理者（seed 実行時のみ使用）
SEED_ADMIN_LOGIN_ID=admin
SEED_ADMIN_PASSWORD=admin1234
