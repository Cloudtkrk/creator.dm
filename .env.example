# ---------------------------------------------------------------------------
# データベース（PostgreSQL）
# ---------------------------------------------------------------------------
# Vercel では Storage から Postgres を接続すると自動で入るため、設定不要です。
# ローカル開発では、Vercel の開発用ブランチか手元のPostgresの接続文字列を書きます。
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# ---------------------------------------------------------------------------
# セッションCookieの署名鍵（必須）
# ---------------------------------------------------------------------------
# 本番では必ずランダムな長い文字列に変更してください。
# 生成: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# 初期管理者（seed 実行時のみ使用）
# ---------------------------------------------------------------------------
SEED_ADMIN_LOGIN_ID=admin
SEED_ADMIN_PASSWORD=admin1234
